
[alias]
  s = status . && git status
  a = !git add -u . && status
  c = commit
  cm = commit -m
  ca = commit --amend
  d = diff
  main = checkout main
  pick = cherry-pick
  aliases = !git config --list | egrep '^alias\\.' | sort

[branch]
  autoSetupRebase = always

[color]
  ui = true
  diff = true

[core]
  pager = less --RAW-CONTROL-CHARS

[pager]
  diff = same-same | LESSANSIENDCHARS=mK less --RAW-CONTROL-CHARS
  show = same-same | LESSANSIENDCHARS=mK less --RAW-CONTROL-CHARS
  log = same-same | LESSANSIENDCHARS=mK less --RAW-CONTROL-CHARS

[interactive]
  diffFilter = same-same -interactive | LESSANSIENDCHARS=mK less --RAW-CONTROL-CHARS
  singleKey = true

[diff]
  algorithm = histogram
  submodule = log
  interHunkCOntext = 0
  noprefix = true
  wsErrorHighlight = none # Intraline coloring creates trouble for same-same.


[diff "swift"]
  # Git 2.55 lacks a built-in Swift pattern. Keep this until the built-in driver is available.
  # Git uses the first capture group as the hunk header; include modifiers and attributes in it.
  xfuncname = "^[ \t]*(([A-Za-z_@][A-Za-z_0-9@]*[ \t]+)*(actor|class|enum|extension|func|struct|protocol)[ \t].*)$"

[difftool]
  prompt = false

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  default = simple

[credential]
  helper = osxkeychain

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
