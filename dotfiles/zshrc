# .zshrc is sourced for interactive shells. Loaded after .zprofile.

source /opt/gloss/zsh/rc.zsh
source /opt/gloss/zsh/aliases.zsh

# Run compinit after all fpath customization so it discovers and caches every completion function.
# Keep the dump in a dedicated directory so Facility can grant access without exposing home or history.
# -i silently skips fpath entries that fail the security audit, instead of prompting.
# The Facility agent hits this: Homebrew completion directories are owned by the principal, not root or the agent.
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
autoload -Uz compinit && compinit -i -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

# Register modules after compinit; add other cmdparse-based modules here as needed.
if (( $+functions[pithy_cmdparse_module_completion] )); then
  pithy_cmdparse_module_completion utest iotest
fi
